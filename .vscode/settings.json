{
    // Сборка идёт через build.sh и scripts/build/*.sh. Расширение CMake Tools
    // не должно само конфигурировать проект в build/: там лежат каталоги
    // build/<режим>-<вариант>, которые создают скрипты
    "cmake.configureOnOpen": false,
    "cmake.buildDirectory": "${workspaceFolder}/build/vscode",

    // Форматирование C/C++ по .clang-format из корня проекта: при сохранении
    // и по Alt+Shift+F. Используется системный clang-format (тот же, что в
    // задаче clang-format), а не встроенный в расширение: разные версии
    // форматируют по-разному
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true
    },
    "[c]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true
    },
    "C_Cpp.formatting": "clangFormat",
    "C_Cpp.clang_format_style": "file",
    "C_Cpp.clang_format_fallbackStyle": "none",
    "C_Cpp.clang_format_path": "/usr/bin/clang-format",

    "folder-color.pathColors": [
        {
            "folderPath": "YAGkP-Lib/apps/bench",
            "color": "foldercolorizer.color_ff005f"
        }
    ]
}